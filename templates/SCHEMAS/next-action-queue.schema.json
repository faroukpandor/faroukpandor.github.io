{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faroukpandor.github.io/templates/SCHEMAS/next-action-queue.schema.json",
  "title": "Operational Next-Action Queue v1",
  "type": "object",
  "required": ["schema", "generated_local", "generated_utc", "owner_of_record", "fields", "actions"],
  "properties": {
    "schema": { "const": "operational-next-action-contract/v1" },
    "generated_local": { "type": "string" },
    "generated_utc": { "type": "string" },
    "owner_of_record": { "type": "string" },
    "maintained_by": { "type": "string" },
    "source_of_truth": { "type": "string" },
    "privacy_rule": { "type": "string" },
    "rebuild_rule": { "type": "string" },
    "fields": { "type": "array", "items": { "type": "string" }, "minItems": 13 },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "opportunity_id", "title", "state", "owner", "next_action", "due_date",
          "review_date", "blocker", "last_verified", "evidence_reference",
          "commercial_exposure", "priority_basis", "decision_needed"
        ],
        "properties": {
          "opportunity_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "state": { "enum": ["TODAY", "DUE", "WAITING", "BLOCKED", "STALE", "HOLD", "DONE"] },
          "owner": { "type": "string", "minLength": 1 },
          "next_action": { "type": "string", "minLength": 5 },
          "due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "review_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "blocker": { "type": "string" },
          "last_verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidence_reference": { "type": "string" },
          "commercial_exposure": { "type": "string" },
          "priority_basis": { "type": "string" },
          "decision_needed": { "type": "string" }
        }
      }
    }
  }
}
