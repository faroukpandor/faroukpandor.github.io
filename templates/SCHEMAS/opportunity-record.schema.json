{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faroukpandor.github.io/templates/SCHEMAS/opportunity-record.schema.json",
  "title": "Canonical Opportunity Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opportunity_id", "date_received", "source_channel", "source_asset",
    "customer_id", "customer_type", "location", "problem", "requirement",
    "category", "urgency", "quantity_frequency", "budget_signal",
    "current_solution", "desired_outcome", "capability_route", "enterprise_route",
    "ownership_status", "commercial_mode", "provider_id", "evidence_ids",
    "quote_id", "cost_id", "compliance_id", "commitment", "status",
    "next_action", "owner", "last_verified", "review_due", "outcome_id", "learning"
  ],
  "properties": {
    "opportunity_id": { "type": "string", "pattern": "^OPP-(\\d{4}-\\d{4}|YYYY-NNNN)$" },
    "date_received": { "type": "string" },
    "source_channel": { "type": "string" },
    "source_asset": { "type": "string" },
    "customer_id": { "type": "string" },
    "customer_type": { "type": "string" },
    "location": { "type": "string" },
    "problem": { "type": "string" },
    "requirement": { "type": "string" },
    "category": { "type": "string" },
    "urgency": { "type": "string" },
    "quantity_frequency": { "type": "string" },
    "budget_signal": { "type": "string" },
    "current_solution": { "type": "string" },
    "desired_outcome": { "type": "string" },
    "capability_route": { "type": "string" },
    "enterprise_route": { "type": "string" },
    "ownership_status": { "enum": ["FAROUK-OWNED", "CLIENT-OWNED", "EMPLOYER-OWNED", "THIRD-PARTY", "PARTNER", "UNKNOWN"] },
    "commercial_mode": { "type": "string" },
    "provider_id": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "quote_id": { "type": "string" },
    "cost_id": { "type": "string" },
    "compliance_id": { "type": "string" },
    "commitment": { "type": "string" },
    "status": { "type": "string" },
    "next_action": { "type": "string" },
    "owner": { "type": "string" },
    "last_verified": { "type": "string" },
    "review_due": { "type": "string" },
    "outcome_id": { "type": "string" },
    "learning": { "type": "string" }
  }
}
