{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faroukpandor.github.io/templates/SCHEMAS/portfolio-opportunity-register.schema.json",
  "title": "Portfolio Opportunity Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "register_type": { "type": "string" },
    "generated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "privacy_rule": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opportunity_id", "created", "source_channel", "source_asset", "opportunity_title",
          "customer_id", "customer_type", "geography", "category", "problem", "requirement",
          "capability_route", "enterprise_destination", "ownership_status", "commercial_mode",
          "evidence_level", "provider_supplier", "economics_status", "compliance_status",
          "customer_commitment", "status", "next_action", "owner", "exposure",
          "last_verified", "review_due", "outcome", "learning", "enterprise_record"
        ],
        "properties": {
          "opportunity_id": { "type": "string", "minLength": 1 },
          "created": { "type": "string" },
          "source_channel": { "type": "string" },
          "source_asset": { "type": "string" },
          "opportunity_title": { "type": "string" },
          "customer_id": { "type": "string" },
          "customer_type": { "type": "string" },
          "geography": { "type": "string" },
          "category": { "type": "string" },
          "problem": { "type": "string" },
          "requirement": { "type": "string" },
          "capability_route": { "type": "string" },
          "enterprise_destination": { "type": "string" },
          "ownership_status": { "enum": ["FAROUK-OWNED", "CLIENT-OWNED", "EMPLOYER-OWNED", "THIRD-PARTY", "PARTNER", "UNKNOWN"] },
          "commercial_mode": { "type": "string" },
          "evidence_level": { "type": "string" },
          "provider_supplier": { "type": "string" },
          "economics_status": { "type": "string" },
          "compliance_status": { "type": "string" },
          "customer_commitment": { "type": "string" },
          "status": { "type": "string" },
          "next_action": { "type": "string", "minLength": 1 },
          "owner": { "type": "string" },
          "exposure": { "type": "string" },
          "last_verified": { "type": "string" },
          "review_due": { "type": "string" },
          "outcome": { "type": "string" },
          "learning": { "type": "string" },
          "enterprise_record": { "type": "string" }
        }
      }
    }
  }
}
